# CodePeer environment configuration
# Copy to .env and fill in.

# HTTP
PORT=8080
LOG_LEVEL=info

# Postgres
DATABASE_URL=postgres://codepeer:codepeer@localhost:5432/codepeer?sslmode=disable

# GitHub App
GITHUB_APP_ID=
# Client ID from the App settings (used as the JWT issuer when set).
GITHUB_APP_CLIENT_ID=
# Path to the app private key PEM file, or the PEM contents themselves.
GITHUB_APP_PRIVATE_KEY=private-key.pem
# Compose-only: host path mounted into the container at /run/secrets/github_private_key
GITHUB_APP_PRIVATE_KEY_FILE=./private-key.pem
GITHUB_WEBHOOK_SECRET=
# Optional: the bot's login for self-event filtering (auto-resolved if empty).
BOT_LOGIN=

# LLM (DeepSeek, OpenAI-compatible Responses API)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
# thinking effort: low | high | max (thinking mode is on by default)
LLM_REASONING_EFFORT=high
LLM_TIMEOUT=300s

# Queue
QUEUE_WORKERS=2
QUEUE_POLL_INTERVAL=2s
QUEUE_MAX_ATTEMPTS=5
QUEUE_LEASE_TTL=15m
